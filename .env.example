# ---------- AI (OpenRouter, OpenAI-compatible) ----------
OPENROUTER_API_KEY=sk-or-v1-...
# Exact model ids. No floating aliases in production: message quality would change by itself.
OPENROUTER_MODEL=deepseek/deepseek-v4-pro-0813
OPENROUTER_MODEL_FAST=deepseek/deepseek-v4.1-flash
# The worker pauses the whole system when the month's AI spend reaches this amount.
OPENROUTER_MONTHLY_BUDGET_USD=20

# ---------- Browser (first contact through the operator's real Chrome) ----------
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile
# false = dry-run: everything runs except the final click on "Send". Set true only for the authorized pilot.
BROWSER_SEND_ENABLED=false

# ---------- Instagram official API (conversation continuation) ----------
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-string
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v26.0
# Tokens generated under "API setup with Instagram login" talk to graph.instagram.com (default).
# Page tokens from "API setup with Facebook login" use https://graph.facebook.com instead.
META_GRAPH_BASE=https://graph.instagram.com

# ---------- Cloudflare inbox (relay/) ----------
# Stable public address that receives Meta's webhooks; the worker pulls events from it every few seconds.
RELAY_URL=https://scriptroom-prospector-inbox.<your-subdomain>.workers.dev
RELAY_TOKEN=

# ---------- Database ----------
DATABASE_URL=./data/prospector.db
BACKUP_DIR=./backups

# ---------- Operating limits ----------
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo
WARMUP_START_PER_DAY=5
WARMUP_STEP_PER_WEEK=5
